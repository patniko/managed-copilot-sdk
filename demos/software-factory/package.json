{
  "name": "@managed-copilot/demo-software-factory",
  "version": "0.1.0",
  "private": true,
  "description": "AI software factory demo: plans work orders, builds tasks in parallel sandboxes, reviews with a second model, and releases a tested bundle, all on Managed Copilot.",
  "type": "module",
  "exports": {
    "./apphost": "./apphost.mts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.tooling.json",
    "dev": "tsx watch --clear-screen=false src/server/main.ts",
    "start": "node dist/server/main.js",
    "happy-path": "node dist/scripts/happy-path.js",
    "smoke:office": "node dist/scripts/smoke-office.js",
    "platform": "node scripts/dev-platform.mjs",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.26",
    "@managed-copilot/protocol": "workspace:*",
    "@managed-copilot/sdk": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.58.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  }
}
