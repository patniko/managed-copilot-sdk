{
  "name": "@managed-copilot/demo-front-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Front Desk: a chat assistant many people use. Each person signs in, gets private conversations and memory, and never sees anyone else's.",
  "type": "module",
  "exports": {
    "./apphost": "./apphost.mts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.tooling.json",
    "dev": "tsx watch --clear-screen=false src/server/main.ts",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts",
    "setup-github": "tsx scripts/setup-github.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.26",
    "@managed-copilot/protocol": "workspace:*",
    "@managed-copilot/sdk": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@managed-copilot/github-theme": "workspace:*",
    "@primer/octicons-react": "19.40.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  }
}
