{
  "name": "@managed-copilot/demo-hack-the-harness",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Hack the Harness: a staff assistant, with a 3D office, whose agent hands spreadsheet work to sandboxed child workers.",
  "type": "module",
  "exports": {
    "./apphost": "./apphost.mts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.tooling.json",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.26",
    "@managed-copilot/sdk": "workspace:*",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jose": "^6.2.14"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@managed-copilot/protocol": "workspace:*",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "marked": "^17.0.5",
    "radix-ui": "^1.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "use-stick-to-bottom": "^1.1.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  }
}
