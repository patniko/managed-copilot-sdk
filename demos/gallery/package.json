{
  "name": "@managed-copilot/demo-gallery",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "One page with every demo and walkthrough, linked to your local platform and your Azure deployment. `pnpm gallery` opens it.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json && tsc -p tsconfig.tooling.json",
    "start": "node dist/server/main.js",
    "capture": "node scripts/capture.mjs",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@managed-copilot/cli": "workspace:*"
  },
  "devDependencies": {
    "@managed-copilot/github-theme": "workspace:*",
    "@primer/octicons-react": "19.40.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  }
}
