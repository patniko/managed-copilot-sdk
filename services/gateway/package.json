{
  "name": "@managed-copilot/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Managed Copilot platform gateway: authenticated admission, routing, session ownership, and platform services.",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@github/copilot": "1.0.103",
    "@github/copilot-sdk": "1.0.26",
    "@managed-copilot/protocol": "workspace:*",
    "vscode-jsonrpc": "8.2.1",
    "ws": "^8.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@managed-copilot/sdk": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
