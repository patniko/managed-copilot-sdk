{
  "name": "@managed-copilot/console",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Managed Copilot operator console: infrastructure health, deployed state, sessions, and harness configuration. The gateway serves the built files at /console.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "vite",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@managed-copilot/github-theme": "workspace:*",
    "@managed-copilot/protocol": "workspace:*",
    "@primer/octicons-react": "19.40.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  }
}
