<Project Sdk="Microsoft.NET.Sdk">
  <!-- Azure deployment details for Managed Copilot that the TypeScript AppHost API does not expose: the environment's
       VNet and NFS storage, and the container app settings the single-writer gateway needs. Referenced from
       aspire.config.json; its [AspireExport] methods appear on the AppHost's generated TypeScript resources. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableAspireIntegrationAnalyzers>true</EnableAspireIntegrationAnalyzers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="13.6.0" />
    <PackageReference Include="Azure.Provisioning.Network" Version="1.1.0" />
    <PackageReference Include="Azure.Provisioning.Storage" Version="1.1.2" />
  </ItemGroup>
  <ItemGroup>
    <!-- MessagePack 2.5.302 arrives transitively through Aspire.Hosting 13.6.0 (StreamJsonRpc) and has a moderate
         denial-of-service advisory with no patched release yet. The AppHost does not deserialize untrusted MessagePack
         data. Remove this suppression when an Aspire update brings a fixed MessagePack. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qhrr-8q5h-9q3h" />
  </ItemGroup>
</Project>
