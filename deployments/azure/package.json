{
  "name": "@managed-copilot/azure",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Azure deployment for Managed Copilot: the gateway's single-writer lease supervisor, the storage qualification probe, and deployment assets.",
  "type": "module",
  "bin": {
    "managed-copilot-lease": "./dist/lease/main.js",
    "managed-copilot-storage-probe": "./dist/probe/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
