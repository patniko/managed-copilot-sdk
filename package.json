{
  "name": "managed-copilot-sdk",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.apphost.json",
    "lint": "eslint .",
    "test": "pnpm -r --if-present run test",
    "clean": "pnpm -r --if-present run clean",
    "dev": "aspire run",
    "reset": "tsx scripts/reset.mts",
    "walkthrough": "pnpm --silent --filter @managed-copilot/walkthroughs walkthrough",
    "gallery": "pnpm --silent --filter @managed-copilot/demo-gallery start",
    "qa": "pnpm --silent --filter @managed-copilot/qa qa"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@managed-copilot/aspire": "workspace:*",
    "@managed-copilot/cli": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.0.0",
    "vscode-jsonrpc": "8.2.1"
  }
}
